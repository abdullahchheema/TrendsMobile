{
  "doctype": "DocType",
  "name": "Mobile Daily Closing",
  "module": "Mobile Shop",
  "engine": "InnoDB",
  "field_order": [
    "company",
    "closing_date",
    "currency",
    "scope_note",
    "balances",
    "notes",
    "closed_by",
    "closed_at",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "closing_date",
      "label": "Closing Date",
      "fieldtype": "Date",
      "default": "Today",
      "reqd": 1
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "default": "PKR",
      "read_only": 1
    },
    {
      "fieldname": "scope_note",
      "label": "Scope",
      "fieldtype": "HTML",
      "options": "<p>Reconcile company cash, bank and wallet accounts. Shared payment accounts appear once. Close POS shifts first. Submitting records the comparison; it does not post an adjustment. Later backdated postings can change the ledger.</p>"
    },
    {
      "fieldname": "balances",
      "label": "Cash & Account Balances",
      "fieldtype": "Table",
      "options": "Mobile Closing Balance",
      "reqd": 1
    },
    {
      "fieldname": "notes",
      "label": "Closing Notes",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "closed_by",
      "label": "Closed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "closed_at",
      "label": "Closed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Mobile Daily Closing",
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "print": 1,
      "report": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "Mobile Shop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "print": 1,
      "report": 1,
      "submit": 1,
      "cancel": 1
    },
    {
      "role": "Mobile Cashier",
      "read": 1,
      "write": 1,
      "create": 1,
      "print": 1,
      "report": 1,
      "submit": 1,
      "cancel": 0
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "print": 1,
      "report": 1,
      "submit": 1,
      "cancel": 0
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "is_submittable": 1,
  "autoname": "COV-CLOSE-.#####"
}
