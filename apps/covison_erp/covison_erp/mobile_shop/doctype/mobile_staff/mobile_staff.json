{
  "doctype": "DocType",
  "name": "Mobile Staff",
  "module": "Mobile Shop",
  "engine": "InnoDB",
  "field_order": [
    "staff_name",
    "enabled",
    "company",
    "warehouse",
    "designation",
    "user",
    "duties_section",
    "can_sell",
    "can_buy",
    "can_handle_payments"
  ],
  "fields": [
    {
      "fieldname": "staff_name",
      "label": "Staff Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Shop / Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse",
      "in_standard_filter": 1
    },
    {
      "fieldname": "designation",
      "label": "Role / Designation",
      "fieldtype": "Select",
      "options": "Manager\nSalesperson\nPurchaser\nCashier\nTechnician\nOther",
      "default": "Salesperson",
      "in_list_view": 1
    },
    {
      "fieldname": "user",
      "label": "Linked Login (Optional)",
      "fieldtype": "Link",
      "options": "User",
      "description": "A linked login selects this staff member automatically. Staff names do not grant system permissions."
    },
    {
      "fieldname": "duties_section",
      "label": "Responsibilities",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "can_sell",
      "label": "Sells Devices",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "can_buy",
      "label": "Buys Devices",
      "fieldtype": "Check",
      "default": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "can_handle_payments",
      "label": "Collects / Pays Money",
      "fieldtype": "Check",
      "default": 0,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Mobile Shop Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Mobile Salesperson",
      "read": 1,
      "select": 1
    },
    {
      "role": "Mobile Cashier",
      "read": 1,
      "select": 1
    },
    {
      "role": "Mobile Purchaser",
      "read": 1,
      "select": 1
    },
    {
      "role": "Mobile Technician",
      "read": 1,
      "select": 1
    },
    {
      "role": "Sales User",
      "read": 1,
      "select": 1
    },
    {
      "role": "Purchase User",
      "read": 1,
      "select": 1
    },
    {
      "role": "Accounts User",
      "read": 1,
      "select": 1
    },
    {
      "role": "Stock User",
      "read": 1,
      "select": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "COV-STF-.####",
  "title_field": "staff_name",
  "search_fields": "staff_name,designation,warehouse",
  "allow_rename": 0
}
