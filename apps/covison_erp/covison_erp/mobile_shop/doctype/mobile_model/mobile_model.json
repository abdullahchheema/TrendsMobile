{
  "doctype": "DocType",
  "name": "Mobile Model",
  "module": "Mobile Shop",
  "engine": "InnoDB",
  "field_order": [
    "model_name",
    "brand",
    "description"
  ],
  "fields": [
    {
      "fieldname": "model_name",
      "label": "Model",
