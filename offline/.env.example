# Copy these names into Vercel -> Project -> Settings -> Environment Variables (never commit real values).
# See DEPLOYMENT.md at the repository root for where each value comes from.

DJANGO_SECRET_KEY=generate-a-long-random-string
COVISON_HTTPS=1

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# The user is covison_app.<project-ref>; the password is the one you set in supabase/hosted/setup.sql.
DATABASE_URL=postgresql://covison_app.PROJECTREF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_PUBLISHABLE_KEY=anon-or-publishable-key
SUPABASE_SECRET_KEY=service-role-or-secret-key

# Only needed for the one-time owner creation command (run on your own computer, not on Vercel):
# COVISON_CRM_OWNER_EMAIL=owner@yourcompany.com
# COVISON_CRM_OWNER_PASSWORD=choose-a-strong-password

# Optional: extra hostnames (custom domain). *.vercel.app names are added automatically.
# DJANGO_ALLOWED_HOSTS=erp.yourcompany.com
# COVISON_TRUSTED_ORIGINS=https://erp.yourcompany.com

# Website (optional): makes stock, price and order changes appear on the storefront instantly. Same secret as ONLINE_API_KEY.
# WEBSITE_REVALIDATE_URL=https://your-website.vercel.app/api/revalidate
